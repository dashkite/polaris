    "@dashkite/assert": "^0.3.0",
    "@dashkite/genie": "^0.20.9",
    "@dashkite/genie-clean": "^0.9.0",
    "@dashkite/genie-coffee": "^0.9.0",
    "@dashkite/genie-module": "^0.5.10",
    "@dashkite/genie-release": "^0.4.3",
    "@dashkite/genie-yaml": "^0.7.0"
  },
  "dependencies": {
