  },
  "homepage": "https://github.com/dashkite/polaris#readme",
  "devDependencies": {
    "@dashkite/amen": "^0.1.2",
    "@dashkite/amen-console": "^0.0.1",
    "@dashkite/assert": "^0.1.3",
    "@dashkite/genie": "^0.8.4",
    "@dashkite/genie-clean": "0.2.0",
    "@dashkite/genie-coffee": "0.2.0",
    "@dashkite/genie-release": "^0.2.10",
    "@dashkite/genie-yaml": "0.1.0"
  },
  "dependencies": {
